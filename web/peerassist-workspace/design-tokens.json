{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "A quiet, evidence-first academic review workspace for teachers and researchers.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.059,
          0.298,
          0.298
        ],
        "hex": "#0f4c4c"
      }
    },
    "primary-hover": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.043,
          0.235,
          0.235
        ],
        "hex": "#0b3c3c"
      }
    },
    "ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.09,
          0.129,
          0.129
        ],
        "hex": "#172121"
      }
    },
    "muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.325,
          0.388,
          0.388
        ],
        "hex": "#536363"
      }
    },
    "paper": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.961,
          0.969,
          0.969
        ],
        "hex": "#f5f7f7"
      }
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.847,
          0.871,
          0.871
        ],
        "hex": "#d8dede"
      }
    },
    "warning": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.541,
          0.294,
          0.031
        ],
        "hex": "#8a4b08"
      }
    },
    "danger": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.706,
          0.137,
          0.094
        ],
        "hex": "#b42318"
      }
    },
    "success": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.078,
          0.424,
          0.263
        ],
        "hex": "#146c43"
      }
    },
    "info": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.09,
          0.361,
          0.827
        ],
        "hex": "#175cd3"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "minimumTouchTarget": {
      "$value": {
        "value": 44,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    }
  },
  "typography": {
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
        "fontSize": {
          "value": 2,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
        "fontSize": {
          "value": 1.375,
          "unit": "rem"
        },
        "fontWeight": 650,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "paper-title": {
      "$type": "typography",
      "$value": {
        "fontFamily": "ui-serif, Georgia, Cambria, Times New Roman, serif",
        "fontSize": {
          "value": 1.25,
          "unit": "rem"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "body-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
        "fontSize": {
          "value": 0.875,
          "unit": "rem"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    }
  }
}
