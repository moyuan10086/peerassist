[Unit]
Description=PeerAssist durable review job API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=peerassist
Group=peerassist
UMask=0077
WorkingDirectory=/opt/peerassist
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/peerassist/src
EnvironmentFile=/etc/peerassist/peerassist.env
ExecStart=/opt/peerassist/.venv/bin/python -m peerassist.review_job_api --data-dir /var/lib/peerassist/data --host 127.0.0.1 --port 8767
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/peerassist/data
InaccessiblePaths=/var/lib/peerassist/workspace

[Install]
WantedBy=multi-user.target
