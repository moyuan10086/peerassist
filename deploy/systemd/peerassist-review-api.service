[Unit]
Description=PeerAssist durable review job API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/peerassist-review-system-20260710/peerassist
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/peerassist-review-system-20260710/peerassist/.venv/bin/python -m peerassist.review_job_api --data-dir data --host 0.0.0.0 --port 8767
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
