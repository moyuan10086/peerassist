[Unit]
Description=PeerAssist review workspace
After=network-online.target peerassist-review-api.service
Wants=network-online.target peerassist-review-api.service

[Service]
Type=simple
User=peerassist-ui
Group=peerassist-ui
SupplementaryGroups=peerassist
UMask=0077
WorkingDirectory=/opt/peerassist
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/peerassist/src
Environment=DATA_DIR=/var/lib/peerassist/workspace/data
EnvironmentFile=/etc/peerassist/peerassist.env
ExecStart=/opt/peerassist/.venv/bin/python -m peerassist.confirmation_server --run-dir /var/lib/peerassist/workspace/run --paper-id current --host 127.0.0.1 --port 8766
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/peerassist/workspace
InaccessiblePaths=/var/lib/peerassist/data
ProtectProc=invisible
ProcSubset=pid

[Install]
WantedBy=multi-user.target
