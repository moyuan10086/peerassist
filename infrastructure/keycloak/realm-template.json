{
  "realm": "${M1_TEST_OIDC_REALM}",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "clients": [
    {
      "clientId": "${M1_TEST_OIDC_AUTOMATION_CLIENT_ID}",
      "enabled": true,
      "publicClient": false,
      "secret": "${M1_TEST_OIDC_AUTOMATION_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "peerassist-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "${M1_TEST_OIDC_AUTOMATION_CLIENT_ID}",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "${M1_TEST_OIDC_PKCE_CLIENT_ID}",
      "enabled": true,
      "publicClient": true,
      "serviceAccountsEnabled": false,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "redirectUris": ["${M1_TEST_OIDC_REDIRECT_URI}"],
      "webOrigins": ["${M1_TEST_PUBLIC_ORIGIN}"],
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "users": [
    {
      "username": "org-a-admin",
      "email": "org-a-admin@peerassist.test",
      "emailVerified": true,
      "firstName": "Org A",
      "lastName": "Admin",
      "enabled": true,
      "credentials": [{"type": "password", "value": "${M1_TEST_OIDC_USER_PASSWORD}", "temporary": false}]
    },
    {
      "username": "org-a-owner",
      "email": "org-a-owner@peerassist.test",
      "emailVerified": true,
      "firstName": "Org A",
      "lastName": "Owner",
      "enabled": true,
      "credentials": [{"type": "password", "value": "${M1_TEST_OIDC_USER_PASSWORD}", "temporary": false}]
    },
    {
      "username": "org-a-reviewer",
      "email": "org-a-reviewer@peerassist.test",
      "emailVerified": true,
      "firstName": "Org A",
      "lastName": "Reviewer",
      "enabled": true,
      "credentials": [{"type": "password", "value": "${M1_TEST_OIDC_USER_PASSWORD}", "temporary": false}]
    },
    {
      "username": "org-a-viewer",
      "email": "org-a-viewer@peerassist.test",
      "emailVerified": true,
      "firstName": "Org A",
      "lastName": "Viewer",
      "enabled": true,
      "credentials": [{"type": "password", "value": "${M1_TEST_OIDC_USER_PASSWORD}", "temporary": false}]
    },
    {
